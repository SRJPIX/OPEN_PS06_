# ==========================================
# Evidra Platform - Environment Configuration
# ==========================================
# Copy this file to .env in local development:
# cp .env.example .env

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/evidra?retryWrites=true&w=majority

# Authentication Configuration (JWT in HTTP-Only Cookies)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=evidra_token

# Development-Only Demo User Seeding (Unavailable in production)
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=EvidraDemo123!

# Frontend Configuration
VITE_API_URL=http://localhost:5000
