# ==========================================
# Evidra Platform - Environment Configuration
# ==========================================
# In local development, copy this file:
#   cp .env.example .env (in project root and/or server/)

# ------------------------------------------
# Backend API Configuration (Server)
# ------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated for multiple origins, e.g. Vercel custom domain + preview)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas in Production, local MongoDB in Development)
# Production example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/evidra?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/evidra

# Authentication Configuration (JWT in secure HTTP-only cookies)
# Production MUST use a random 64-character secret
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=7d
COOKIE_NAME=evidra_token

# Seed Controls (Strictly blocked when NODE_ENV=production)
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=EvidraDemo123!

# Optional AI Providers (Backend falls back to deterministic regex parser if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------
# Frontend Configuration (Client / Vercel)
# ------------------------------------------
# Point to your Render backend API URL in production
# Example: https://evidra-api.onrender.com/api
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api
