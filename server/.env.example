# Evidra Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual configuration.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# For MongoDB Atlas:
# Ensure your current public IP address is whitelisted in Atlas -> Security -> Network Access
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/evidra?retryWrites=true&w=majority
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/evidra

# Authentication & Session
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long_for_dev
JWT_EXPIRES_IN=7d
COOKIE_NAME=evidra_token

# Demo Data Seeding (development only)
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=EvidraDemo123!

# Optional AI Providers
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

